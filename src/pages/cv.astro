---
import Layout from "../layouts/Layout.astro";
import { existsSync } from "node:fs";
const hasCV = existsSync(new URL("../../public/cv.pdf", import.meta.url));
---
<Layout title="CV" description="Curriculum vitae of Mark Zhao.">
<div class="page-stack"><header class="page-header"><h1 class="page-title">CV</h1><p class="page-description">Mark Zhao · Machine Learning Engineer</p></header>
{hasCV ? <a class="action-link" href="/cv.pdf" download>Download CV (PDF) ↓</a> : <p class="body-copy">My CV will be available here soon.</p>}
<a href="/about" class="action-link">About me →</a></div>
</Layout>
