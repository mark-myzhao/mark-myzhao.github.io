---
import Layout from "../layouts/Layout.astro";
import { photographs, photographyWebsite } from "../data/photography";
---
<Layout title="Photography" description="A personal collection of photographs." schemaType="CollectionPage">
<div class="page-stack">
<header class="page-header"><h1 class="page-title">Photography</h1><p class="page-description">Outside of machine learning, I enjoy photography.</p>
{photographyWebsite && <a class="action-link" href={photographyWebsite} target="_blank" rel="noopener noreferrer">Visit my photography website ↗</a>}</header>
{photographs.length === 0 ? <p class="body-copy">Selected photographs will be added here soon.</p> :
<div class="grid grid-cols-1 gap-x-7 gap-y-9 sm:grid-cols-2">{photographs.map(photo =>
<figure class="group space-y-3">
  <a href={photo.href} target="_blank" rel="noopener noreferrer" aria-label={`View ${photo.title} photography`} class="block overflow-hidden rounded-xl bg-paper-200 dark:bg-ink-800">
    <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="1280" height="720" referrerpolicy="no-referrer" class="aspect-video h-auto w-full object-cover transition duration-500 ease-out group-hover:scale-[1.015]" />
  </a>
  <figcaption class="flex items-center justify-between gap-3">
    <span class="entry-title text-[1.0625rem]">{photo.title}</span>
    <span class="i-mdi:arrow-top-right text-ink-400 transition group-hover:text-accent-700 dark:text-paper-500 dark:group-hover:text-accent-200" aria-hidden="true"></span>
  </figcaption>
</figure>
)}</div>}
</div>
</Layout>
